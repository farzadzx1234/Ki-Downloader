{
  "manifest_version": 3,
  "name": "Ki-Downloader Companion",
  "version": "1.0.0",
  "description": "Intercept browser downloads, send links via right-click, or grab all page links into Ki-Downloader.",
  "permissions": ["downloads", "contextMenus", "tabs", "storage", "scripting", "activeTab"],
  "host_permissions": ["http://127.0.0.1:45780/*"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Ki-Downloader"
  }
}
